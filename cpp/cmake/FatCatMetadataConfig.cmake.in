@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json 3.12.0 CONFIG)
if(NOT @FATCAT_BUNDLED_TINYXML2@)
    find_dependency(tinyxml2 10.0 CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/FatCatMetadataTargets.cmake")
set_and_check(FatCatMetadata_DATA_DIR "@PACKAGE_FATCAT_DATA_INSTALL_DIR@")
set(FatCatMetadata_SOURCE_REVISION "@FATCAT_SOURCE_REVISION@")
set(FatCatMetadata_SOURCE_DIRTY @FATCAT_SOURCE_DIRTY@)
check_required_components(FatCatMetadata)
